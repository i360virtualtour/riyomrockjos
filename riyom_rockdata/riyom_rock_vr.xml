  set(hotspot[spotpoint54].visible, true);



  
  set(hotspot[spotpoint55].visible, true);
  </action>
  <events name="pano46stopanimatedspots" onremovepano="" />


  <action name="showpanospotsaction">
    resumeTourSoundsActions(true,false,false,false,true);
    if (tour_displayspots,
    showpanopointspots();
    );
  </action>
  <action name="hidepanospotsaction">
    pauseTourSoundsActions(true,false,false,false,true);
    hidepanopointspots();
  </action>

  <!-- **** 1 Directional Sound Spots **** -->
  <action name="playpanolocalsounds">
    if (tour_soundson,
      div(volume, tour_soundsvolume, 100);
      if(device.flash,
        set(spotsound62_started, true);
        set(spotsound62_paused, false);
        playsound3D(spotsound62, "front.mp3", -15.934426, -72.236842, 90, get(volume), 1);
      ,
        if(device.html5,
          set(spotsound62_started, true);
          set(spotsound62_paused, false);
          playsound(spotsound62, "front.mp3", 1);
        );
      );
    );
  </action>
  <action name="stoppanolocalsounds">
    set(spotsound62_started, false);
    set(spotsound62_paused, false);
    stopsound(spotsound62);
  </action>
  <action name="setpanolocalsoundsvolume">
    if (tour_soundson,
      div(volume, tour_soundsvolume, 100);
    );
  </action>
  <action name="pausepanolocalsounds">
    if(spotsound62_started,
      ifnot(spotsound62_paused,
        set(spotsound62_paused, true);
        pausesound(spotsound62);
      );
    );
  </action>
  <action name="resumepanolocalsounds">
    if(tour_soundson,
      div(volume, tour_soundsvolume, 100);

      set(killDirectionalSound, false);
      for(set(hotspotSoundi, 0), hotspotSoundi LT hotspot.count, inc(hotspotSoundi),
        if(hotspot[get(hotspotSoundi)].pauseothersounds,
          if(hotspot[get(hotspotSoundi)].stateVideo == 'playing',
            set(killDirectionalSound, true);
          );
        );
      );
      ifnot (killDirectionalSound,
      if(spotsound62_started,
        if(spotsound62_paused,
          set(spotsound62_paused, false);
          resumesound(spotsound62);
        );
      ,

        if(device.flash,
          set(spotsound62_started, true);
          set(spotsound62_paused, false);
          playsound3D(spotsound62, "front.mp3", -15.934426, -72.236842, 90, get(volume), 1);
        ,
          if(device.html5,
            set(spotsound62_started, true);
            set(spotsound62_paused, false);
            playsound(spotsound62, "front.mp3", 1);
          );
        );
      );
      );
    ,
    );
  </action>
  <events name="pano46soundsevents" onnewpano="if(plugin[soundinterface],if(plugin[soundinterface].started,playpanolocalsounds();););" />


</scene>

  <krpano nofullspherepanoavailable="false" />


  <!-- Awake HTML5 plugins -->
  <events name="eventKrpanoLoadedEvts" onxmlcomplete="eventKrpanoLoadedAction();" keep="true" />
  <action name="eventKrpanoLoadedAction">
    
    set(events[eventKrpanoLoadedEvts].name, null);
    js(eventKrpanoLoaded('webvr'));
  </action>

</krpano>

